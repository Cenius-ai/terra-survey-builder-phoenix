# Copy this file to `.env` and fill in the real values for production.
# `.env` is gitignored and should NEVER be committed.
# Values here are placeholders / examples ONLY — they are NOT valid secrets.

# ─── Required in production ───

# Phoenix secret key base (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=cenius-dev-replace-in-production-a1b2c3d4e5f6a7b8

# Session signing salt (generate with: mix phx.gen.secret 32)
SESSION_SIGNING_SALT=cenius-dev-replace-in-production-session-salt

# LiveView signing salt (generate with: mix phx.gen.secret 32)
LIVE_VIEW_SIGNING_SALT=cenius-dev-replace-in-production-liveview-salt

# ─── Optional ───

# Server port (default: 4000)
PORT=4000

# Database path (default: terra_dev.db in project dir)
DATABASE_PATH=terra_dev.db
