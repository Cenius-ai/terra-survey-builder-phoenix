<div class="min-h-screen">
  <%!-- Aurora hero --%>
  <div class="relative overflow-hidden pb-16 pt-12">
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
    </div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
          Terra
        </h1>
        <div class="flex items-center gap-1">
          <%= if @current_user do %>
            <a
              href="/logout"
              class="text-sm text-muted-foreground hover:text-foreground px-2 py-1 rounded-lg hover:bg-secondary transition-colors"
            >
              Log out
            </a>
          <% else %>
            <a
              href="/login"
              class="text-sm text-muted-foreground hover:text-foreground px-2 py-1 rounded-lg hover:bg-secondary transition-colors"
            >
              Sign in
            </a>
          <% end %>
          <button
            id="theme-toggle"
            class="p-2 rounded-lg hover:bg-secondary transition-colors duration-150"
            aria-label="Toggle theme"
          >
            <%!-- Sun icon (shown in dark mode) --%>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden dark:block text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <%!-- Moon icon (shown in light mode) --%>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 block dark:hidden text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
      <p class="text-muted-foreground text-lg mb-8">
        Create beautiful surveys with logic branching.
      </p>

      <%!-- Create survey form (auth only) --%>
      <%= if @current_user do %>
        <form phx-submit="create_survey" class="flex gap-2 mb-12">
          <input
            type="text"
            name="title"
            placeholder="Enter a survey title..."
            required
            class="flex-1 rounded-lg border border-border bg-card px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-colors duration-150"
          />
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-lg bg-accent text-on-accent px-5 py-3 text-sm font-semibold hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:opacity-50 transition-colors duration-150 whitespace-nowrap"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Create Survey
          </button>
        </form>
      <% else %>
        <div class="mb-12 rounded-xl border border-border bg-card p-5 text-center">
          <p class="text-sm text-muted-foreground">
            <a href="/login" class="font-medium text-accent hover:underline">Sign in</a> to create and manage surveys.
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <%!-- Survey list --%>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 pb-16">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold text-foreground">
        <%= length(@surveys) %> <%= if length(@surveys) == 1, do: "Survey", else: "Surveys" %>
      </h2>
    </div>

    <%= if @surveys == [] do %>
      <div class="text-center py-16 rounded-xl border-2 border-dashed border-border">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-muted-foreground text-sm">No surveys yet.</p>
      </div>
    <% else %>
      <div class="space-y-3">
        <%= for {survey, idx} <- Enum.with_index(@surveys) do %>
          <div
            class="group rounded-xl border border-border bg-card p-5 hover:border-accent/30 transition-all duration-200 animate-card-in"
            style={"animation-delay: #{idx * 60}ms"}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-base font-semibold text-foreground truncate"><%= survey.title %></h3>
                  <span class={[
                    "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
                    if(survey.published, do: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400", else: "bg-secondary text-muted-foreground")
                  ]}>
                    <%= if survey.published, do: "Published", else: "Draft" %>
                  </span>
                </div>
                <p class="text-xs text-muted-foreground">
                  <%= length(survey.questions) %> questions · <%= survey.slug %>
                </p>
              </div>

              <div class="flex items-center gap-1 opacity-60 group-hover:opacity-100 transition-opacity">
                <%!-- Take survey link (always visible for published surveys) --%>
                <a
                  :if={survey.published}
                  href={"/s/#{survey.slug}"}
                  class="p-2 rounded-lg hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                  title="Take survey"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a
                  href={"/surveys/#{survey.id}/results"}
                  class="p-2 rounded-lg hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                  title="View results"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                </a>

                <%!-- Management controls (auth only) --%>
                <%= if @current_user do %>
                  <a
                    href={"/builder/#{survey.id}"}
                    class="p-2 rounded-lg hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                    title="Edit survey"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </a>
                  <button
                    phx-click="toggle_publish"
                    phx-value-id={survey.id}
                    class="p-2 rounded-lg hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors"
                    title={if(survey.published, do: "Unpublish", else: "Publish")}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </button>
                  <button
                    phx-click="delete_survey"
                    phx-value-id={survey.id}
                    class="p-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 text-muted-foreground hover:text-destructive transition-colors"
                    title="Delete survey"
                    data-confirm="Delete this survey?"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
