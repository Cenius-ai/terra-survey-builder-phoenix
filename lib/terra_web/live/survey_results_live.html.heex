<div class="min-h-screen">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
    <%!-- Header --%>
    <div class="flex items-center gap-3 mb-8">
      <a href="/" class="p-2 -ml-2 rounded-lg hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-foreground"><%= @survey.title %></h1>
        <p class="text-sm text-muted-foreground">
          <%= @total %> <%= if @total == 1, do: "response", else: "responses" %>
        </p>
      </div>
    </div>

    <%= if @total == 0 do %>
      <div class="text-center py-16 rounded-xl border-2 border-dashed border-border">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <p class="text-muted-foreground text-sm">No responses yet. Share the survey to collect feedback.</p>
        <a
          href={"/s/#{@survey.slug}"}
          class="inline-flex items-center gap-1.5 mt-4 rounded-lg bg-accent text-on-accent px-4 py-2 text-sm font-semibold hover:opacity-90 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          Take survey
        </a>
      </div>
    <% else %>
      <%!-- Question results --%>
      <div class="space-y-6">
        <%= for {question, agg} <- @aggregations do %>
          <div class="rounded-xl border border-border bg-card p-5 shadow-sm animate-card-in">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-medium uppercase tracking-wider text-accent"><%= question.type %></span>
            </div>
            <h3 class="text-sm font-semibold text-foreground mb-4"><%= question.title %></h3>

            <%!-- Rating aggregation --%>
            <%= if agg.type == :rating do %>
              <div class="mb-3">
                <div class="flex items-baseline gap-2 mb-3">
                  <span class="text-2xl font-bold text-foreground"><%= Float.round(agg.average, 1) %></span>
                  <span class="text-sm text-muted-foreground">/ 5 average</span>
                </div>
                <div class="space-y-1.5">
                  <%= for {rating, count, pct} <- agg.distribution do %>
                    <div class="flex items-center gap-2">
                      <span class="w-6 text-right text-xs text-muted-foreground font-mono"><%= rating %></span>
                      <div class="flex-1 h-5 rounded-full bg-secondary overflow-hidden">
                        <div
                          class="h-full rounded-full bg-accent transition-all duration-500"
                          style={"width: #{pct}%"}
                        >
                        </div>
                      </div>
                      <span class="w-12 text-xs text-muted-foreground"><%= count %> (<%= Float.round(pct, 1) %>%)</span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%!-- Multiple choice aggregation --%>
            <%= if agg.type == :choice do %>
              <div class="space-y-1.5">
                <%= for {label, count, pct} <- agg.counts do %>
                  <div class="flex items-center gap-2">
                    <span class="w-32 text-xs text-muted-foreground truncate" title={label}><%= label %></span>
                    <div class="flex-1 h-5 rounded-full bg-secondary overflow-hidden">
                      <div
                        class="h-full rounded-full bg-accent transition-all duration-500"
                        style={"width: #{pct}%"}
                      >
                      </div>
                    </div>
                    <span class="w-16 text-xs text-muted-foreground"><%= count %> (<%= Float.round(pct, 1) %>%)</span>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%!-- Text aggregation --%>
            <%= if agg.type == :text do %>
              <div class="space-y-2">
                <%= for answer <- agg.answers do %>
                  <div class="rounded-lg border border-border bg-secondary/20 px-3 py-2 text-sm text-foreground">
                    <%= answer %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <%!-- Individual responses --%>
      <div class="mt-8 pt-6 border-t border-border">
        <h2 class="text-lg font-semibold text-foreground mb-4">Individual Responses</h2>
        <div class="space-y-3">
          <%= for {response, idx} <- Enum.with_index(@responses) do %>
            <details class="group rounded-xl border border-border bg-card overflow-hidden">
              <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-secondary/30 transition-colors">
                <span class="text-sm font-medium text-foreground">
                  Response #<%= idx + 1 %>
                </span>
                <span class="text-xs text-muted-foreground">
                  <%= NaiveDateTime.to_string(response.inserted_at) %>
                </span>
              </summary>
              <div class="border-t border-border px-4 py-3 space-y-2 bg-secondary/10">
                <%= for question <- @questions do %>
                  <% answer = response.answers[to_string(question.position)] %>
                  <%= if answer do %>
                    <div>
                      <span class="text-xs font-medium text-muted-foreground"><%= question.title %></span>
                      <p class="text-sm text-foreground"><%= answer %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>
    <% end %>

    <%!-- Bottom navigation --%>
    <div class="flex items-center justify-between mt-8 pt-6 border-t border-border">
      <a href="/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Back to surveys
      </a>
      <div class="flex gap-2">
        <a
          href={"/builder/#{@survey.id}"}
          class="inline-flex items-center gap-1.5 rounded-lg bg-secondary text-on-secondary px-4 py-2 text-sm font-semibold hover:opacity-80 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit
        </a>
        <a
          href={"/s/#{@survey.slug}"}
          class="inline-flex items-center gap-1.5 rounded-lg bg-accent text-on-accent px-4 py-2 text-sm font-semibold hover:opacity-90 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          Take Survey
        </a>
      </div>
    </div>
  </div>
</div>
